# Anthropic API key - required for AI features
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string. Any provider works:
#   - Vercel Postgres: `vercel env pull .env.local` after attaching the DB
#   - Neon / Supabase / RDS: paste the postgres:// URL they give you
#   - Local Docker: postgres://postgres:pw@localhost:5432/postgres
DATABASE_URL=

# Workspace password — required. The single user signs in with this at /login.
APP_PASSWORD=

# Secret used to sign session cookies — required. At least 16 chars.
# Generate one with: openssl rand -base64 32
APP_SESSION_SECRET=

# xAI API key — optional. Studio voice works without it.
# Set this only if you want the higher xAI voices and Sharpen lines.
# Get one at https://console.x.ai/
XAI_API_KEY=

# HeyGen API key — optional leftover for talking-head rendering.
# Get one at https://app.heygen.com → Space settings → API.
# Set up your digital twin (avatar) + cloned voice in the HeyGen dashboard,
# then pick them once in /integrations to save the ids to your Profile.
HEYGEN_API_KEY=

NEXT_PUBLIC_APP_NAME=CreatorAI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI spending cap - optional. Estimated USD per day across all AI calls.
# When reached, AI features return a friendly "limit reached" message until
# midnight UTC. Default 5.
AI_DAILY_BUDGET_USD=5
# Max voiceovers per day. Default 100.
AI_DAILY_VOICE_LIMIT=100
# Model overrides - optional. Defaults: claude-sonnet-4-6 and claude-opus-4-7.
# AI_MODEL_DEFAULT=claude-sonnet-4-6
# AI_MODEL_PREMIUM=claude-opus-4-7

# YouTube posting - optional. See docs/youtube-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <site origin>/api/youtube/callback
# GOOGLE_REDIRECT_URI=
# Optional. Key for encrypting OAuth tokens. Defaults to APP_SESSION_SECRET.
# TOKEN_ENCRYPTION_KEY=
